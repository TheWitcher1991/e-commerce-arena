# Compose configuration only. Copy to root .env and replace both secrets.
# Generate URL-safe credentials with: openssl rand -hex 24 / openssl rand -hex 32
POSTGRES_DB=ecommerce_arena
POSTGRES_USER=arena
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
